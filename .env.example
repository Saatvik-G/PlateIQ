# ──────────────────────────────────────────────────────────────
# PlateIQ — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────

# ── Firebase Client SDK (public — safe to expose in browser) ──
# Found in Firebase Console → Project Settings → Your apps → SDK config

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# ── Firebase Admin SDK (server-only — never expose in browser) ──
# Found in Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the private_key value below (include the BEGIN/END PRIVATE KEY lines, replace newlines with \n)

FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Google Gemini API (server-only) ──
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Create a key in a NEW project to ensure free-tier quota is available.
# Used by: /api/sous-chef and /api/rescue-description

GEMINI_API_KEY=your_gemini_api_key_here
